{
    # DNS provider credentials are supplied through an environment variable.
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

# Reusable access-control policy for administrative services.
(admin_only) {
    # Example addresses only.
    # Individual mesh-VPN clients and the trusted LAN can be allowlisted.
    @admin_allowed remote_ip 100.64.0.10 100.64.0.20 192.168.1.0/24

    handle @admin_allowed {
        reverse_proxy {args[0]}
    }

    handle {
        respond "Forbidden" 403
    }
}

# Administrative service:
# only clients matching the allowlist can reach the upstream.
dashboard.example.com {
    import admin_only 127.0.0.1:3000
}

monitoring.example.com {
    import admin_only 127.0.0.1:3001
}

# Example of a service that does not use the administrative allowlist.
media.example.com {
    reverse_proxy 127.0.0.1:8096
}